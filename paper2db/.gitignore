.venv/
# Python
__pycache__/
*.pyc
.DS_Store

# Generated by ./pipeline from paper/ - rebuild, do not commit
# (see README "Regenerating tests/reconstructed/ and tests/sections/"). Only
# the hand-tuned inputs re-included below stay tracked. output/ and
# reconstructed/ are pre-move trees; stale local copies stay ignored.
# metadata/ (LLM classification decisions) is entirely tracked, not gitignored.
output/*
!output/lq/
output/lq/*
!output/lq/*/
output/lq/*/*
!output/lq/*/starts.json
/reconstructed/*
!reconstructed/lq/
reconstructed/lq/*
!reconstructed/lq/*/
reconstructed/lq/*/*
!reconstructed/lq/*/starts.json
classified/*
!classified/mc/
classified/mc/*
!classified/mc/llm_classifications.json
!classified/lq/
classified/lq/*
!classified/lq/llm_classifications.json
!classified/lq/candidate_performance.json
intermediate/
tests/reconstructed/*
!tests/reconstructed/lq/
tests/reconstructed/lq/*
!tests/reconstructed/lq/*/
tests/reconstructed/lq/*/*
!tests/reconstructed/lq/*/starts.json
tests/sections/
.lavish/*
!.lavish/pr-evidence
!.lavish/pr-evidence/**

# QB pipeline (copyrighted DOCX/PDF/crops — gitignored per plan D3)
qb/
qb-pdf/
.lavish/qb-review/

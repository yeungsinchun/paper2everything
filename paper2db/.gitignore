.venv/
# Python
__pycache__/
*.pyc
.DS_Store

# Generated by ./pipeline from paper/ - rebuild, do not commit
# (see README "Regenerating tests/reconstructed/ and tests/sections/"). Only
# the hand-tuned inputs re-included below stay tracked. output/ and
# reconstructed/ are pre-move trees; stale local copies stay ignored.
# metadata/ (LLM classification decisions) is entirely tracked, not gitignored.
output/
/reconstructed/
/classified/
intermediate/
tests/reconstructed/*
!tests/reconstructed/lq/
tests/reconstructed/lq/*
!tests/reconstructed/lq/*/
tests/reconstructed/lq/*/*
!tests/reconstructed/lq/*/starts.json
tests/sections/
.lavish/

# QB pipeline (copyrighted DOCX/PDF/crops — gitignored per plan D3)
qb/
qb-pdf/

# qb-web-ui staging (committed crops + metadata for /qb UI — not DOCX/PDF)
!qb-web-ui-staging/
!qb-web-ui-staging/**

# F01 corpus-agnostic: keep bank census and source manifest tracked (re-include metadata/qb directory first)
!metadata/qb/
!metadata/qb/banks.json
!metadata/qb/source-manifest.json

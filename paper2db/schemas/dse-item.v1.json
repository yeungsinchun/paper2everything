{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "paper2db.dse-item.v1",
  "description": "One HKDSE Physics past-paper question record (Paper 1A MC or Paper 1B LQ) joining its crop, section classification, marking-scheme key, candidate performance and source pointers. Paths are relative to the paper2db root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "paper", "year", "question", "scope", "sections", "classification", "marks", "images", "answer", "answer_pointer", "performance", "sources", "warnings"],
  "properties": {
    "schema": {"type": "string", "const": "paper2db.dse-item.v1"},
    "id": {"type": "string", "pattern": "^dse-(mc-[0-9a-z]+-[0-9]+|lq-[0-9a-z]+-q[0-9]+)$", "description": "e.g. dse-mc-2012-1, dse-lq-pp-q3"},
    "paper": {"type": "string", "enum": ["mc", "lq"], "description": "mc = Paper 1A, lq = Paper 1B"},
    "year": {"type": "string", "pattern": "^(20[0-9]{2}|pp|sap)$", "description": "Exam year, or pp / sap for the practice and sample papers"},
    "question": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "enum": ["in-scope", "out-of-scope"], "description": "in-scope when the primary section belongs to Books 2, 4 or 5"},
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "all"],
      "properties": {
        "primary": {"$ref": "#/definitions/section"},
        "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/section"}, "description": "Every section the question is listed under, primary first"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "uncertain", "source"],
      "properties": {
        "reason": {"type": "string"},
        "uncertain": {"type": ["boolean", "null"], "description": "MC classifications carry an uncertain flag; LQ classifications do not (null)"},
        "source": {"type": "string", "description": "Tracked classification JSON the decision came from"}
      }
    },
    "marks": {"type": ["integer", "null"], "minimum": 1, "description": "1 for MC; null for LQ (per-question marks are not extracted)"},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {"oneOf": [{"$ref": "#/definitions/image"}, {"type": "null"}], "description": "Question crop; null only for an out-of-scope record whose crop was not generated"},
        "answer": {"oneOf": [{"$ref": "#/definitions/image"}, {"type": "null"}], "description": "Marking-scheme crop (LQ only); null when the marking scheme was not cropped"}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "option", "percentage", "deleted"],
      "properties": {
        "status": {"type": "string", "enum": ["present", "missing", "deleted", "not-applicable"], "description": "not-applicable for LQ, whose answer is the marking-scheme crop"},
        "option": {"type": ["string", "null"], "pattern": "^[A-D]$"},
        "percentage": {"type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "Percentage of candidates choosing the correct option"},
        "deleted": {"type": "boolean", "description": "Question was deleted from the marking scheme"}
      }
    },
    "answer_pointer": {
      "oneOf": [{"$ref": "answer-pointer.v1.json#/definitions/pointer"}, {"type": "null"}],
      "description": "Resolved metadata/pointers/dse.json pointer (verified > derived > inferred), or null when absent"
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {"type": "string", "enum": ["present", "missing", "not-applicable"]},
        "note": {"type": ["string", "null"], "description": "Candidate-performance note (LQ only)"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_pdf", "answer_pdf", "pages"],
      "properties": {
        "paper_pdf": {"type": "string", "description": "Source exam PDF under paper/"},
        "answer_pdf": {"type": ["string", "null"], "description": "Marking-scheme PDF under paper/ans, or null when none exists for this paper"},
        "pages": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {"type": "integer", "minimum": 0},
                "to": {"type": "integer", "minimum": 0}
              }
            }
          ],
          "description": "Zero-based page_from..page_to of the LQ question stack; null for MC"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "enum": ["missing_answer", "missing_percentage", "missing_crop", "missing_answer_crop", "missing_performance", "uncertain_classification"]}
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "book", "folder", "title"],
      "properties": {
        "num": {"type": "integer", "minimum": 1, "maximum": 27},
        "book": {"type": "string", "description": "Book folder, e.g. 02_Force_and_Motion"},
        "folder": {"type": "string", "description": "Section folder, e.g. 05_Motion"},
        "title": {"type": "string"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "width", "height"],
      "properties": {
        "path": {"type": "string", "description": "PNG path relative to the paper2db root"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}

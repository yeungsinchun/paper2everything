{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "paper2db.notes-pointer.v1",
  "description": "Canonical question-to-teaching references. Separate from answer-crop pointers. Verification requires documented conceptual correspondence, not merely an existing anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "paper2db.notes-pointer.v1"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/item"
      }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus",
        "item_id",
        "passages"
      ],
      "properties": {
        "corpus": {
          "enum": [
            "qb",
            "dse"
          ]
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "passages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/passage"
          }
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "anchor",
        "text_sha256",
        "highlights",
        "source",
        "tier"
      ],
      "properties": {
        "page": {
          "type": "string",
          "pattern": "^book[1-9][0-9]*/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.html$"
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/highlight"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tier": {
          "enum": [
            "verified",
            "derived",
            "inferred"
          ]
        }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/game/**",
              "components/learning/**",
              "components/nav/**",
              "ui_kits/notes-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|Nunito|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, Nunito, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|tier|progress|goal|unlocked|key|ref|className|style|children)$/]",
        "message": "<AchievementBadge> doesn't accept that prop. Declared props: icon, title, tier, progress, goal, unlocked."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementBadge'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:bronze|silver|gold)$/]",
        "message": "<AchievementBadge> tier must be one of 'bronze' | 'silver' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementToast'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|tier|key|ref|className|style|children)$/]",
        "message": "<AchievementToast> doesn't accept that prop. Declared props: icon, title, tier."
      },
      {
        "selector": "JSXOpeningElement[name.name='AchievementToast'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:bronze|silver|gold)$/]",
        "message": "<AchievementToast> tier must be one of 'bronze' | 'silver' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconOnly|label|href|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconOnly, label, href, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|sun|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'sun' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|sub|icon|iconSrc|progress|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<ChapterCard> doesn't accept that prop. Declared props: label, title, sub, icon, iconSrc, progress, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:num|caption|animated|children|key|ref|className|style|children)$/]",
        "message": "<FigureFrame> doesn't accept that prop. Declared props: num, caption, animated, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormulaTerm'] > JSXAttribute > JSXIdentifier[name!=/^(?:sym|meaning|unit|color|key|ref|className|style|children)$/]",
        "message": "<FormulaTerm> doesn't accept that prop. Declared props: sym, meaning, unit, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='HelpLocation'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|where|href|key|ref|className|style|children)$/]",
        "message": "<HelpLocation> doesn't accept that prop. Declared props: title, where, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, src, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LearningObjective'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|code|ext|done|key|ref|className|style|children)$/]",
        "message": "<LearningObjective> doesn't accept that prop. Declared props: text, code, ext, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|stroke|color|children|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, size, stroke, color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickCheckOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|figure|key|ref|className|style|children)$/]",
        "message": "<QuickCheckOption> doesn't accept that prop. Declared props: label, icon, figure."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|key|ref|className|style|children)$/]",
        "message": "<StatPill> doesn't accept that prop. Declared props: kind, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatPill'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:streak|xp|level)$/]",
        "message": "<StatPill> kind must be one of 'streak' | 'xp' | 'level'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:crumbs|streak|xp|level|onHome|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: crumbs, streak, xp, level, onHome."
      },
      {
        "selector": "JSXOpeningElement[name.name='Trap'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|wrong|right|label|key|ref|className|style|children)$/]",
        "message": "<Trap> doesn't accept that prop. Declared props: children, wrong, right, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='XPBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|level|key|ref|className|style|children)$/]",
        "message": "<XPBar> doesn't accept that prop. Declared props: value, max, level."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }

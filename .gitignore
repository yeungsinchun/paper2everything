# OS / editor
.DS_Store
Thumbs.db
~$*
*.swp

# lavish boards and node_modules are never committed (repo-wide)
.lavish/
node_modules/

# paper2notes local source (gitignored, keep on disk)
paper2notes/active-physics/
paper2notes/ch1.pdf
paper2notes/ch2.pdf
paper2notes/ch3.pdf
paper2notes/ch4.pdf
paper2notes/ch5.pdf
paper2notes/dse-classified/
paper2notes/notes/_local/
paper2notes/notes/**/_local/
paper2notes/notes/_source/**/_scratch/
paper2notes/bk2-*.png
paper2notes/bk4-*.png

# paper2db generated
paper2db/.venv/
paper2db/__pycache__/
paper2db/*.pyc
paper2db/qb/
paper2db/qb-pdf/
!paper2db/qb-web-ui-staging/
!paper2db/qb-web-ui-staging/**
/new_qb/
# Legacy pre-move trees; paper2db/.gitignore ignores these wholesale too.
paper2db/output/
paper2db/reconstructed/
paper2db/classified/
# paper2notes audit harness (QB crops — never commit)
paper2notes/.audit/
paper2notes/.audit-cache/
.audit/
.audit-cache/

# paper2mock
paper2mock/.venv/

# monorepo
.venv/
__pycache__/
*.pyc
.no-mistakes/
*.tmp
